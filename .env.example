# ==============================================================================
# PlacementBuddy - Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# DO NOT commit .env.local or any secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND (Vercel) Environment Variables
# ------------------------------------------------------------------------------
# URL of the deployed FastAPI backend on Render (e.g. https://placementbuddy-backend.onrender.com)
FASTAPI_URL="https://your-backend-app.onrender.com"
NEXT_PUBLIC_API_URL="https://your-backend-app.onrender.com"

# NextAuth v4 Configuration
NEXTAUTH_SECRET="generate_a_random_32_byte_secret_key"
NEXTAUTH_URL="https://your-app.vercel.app"

# Google OAuth 2.0 Credentials (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ------------------------------------------------------------------------------
# 2. BACKEND (Render) Environment Variables
# ------------------------------------------------------------------------------
# Neon Serverless PostgreSQL Database Connection String (https://console.neon.tech)
DATABASE_URL="postgresql://neondb_owner:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Allowed CORS origins for FastAPI (comma-separated URLs, or * for public access)
ALLOWED_ORIGINS="https://your-app.vercel.app,http://localhost:3000"

# Optional Gemini API key for advanced AI features
GEMINI_API_KEY="your_gemini_api_key_here"

# Render provides PORT automatically (default: 8000)
PORT=8000
